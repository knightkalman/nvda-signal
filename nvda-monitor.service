[Unit]
Description=NVDA stock prices and semiconductor/AI news monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/git/nvda-signal
ExecStart=/usr/bin/python3 %h/Desktop/git/nvda-signal/nvda_monitor.py
Restart=on-failure
RestartSec=15s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
